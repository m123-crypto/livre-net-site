{# params: src, label, tone ('avant'|'apres'), alt #}
<figure class="photo photo--{{ tone }}">
  {% if src %}<img src="{{ src }}" alt="{{ alt or label }}" loading="lazy">{% else %}<img src="/assets/img/illustrations/{{ tone }}.svg" alt="Illustration : pièce {{ 'avant' if tone == 'avant' else 'après' }} le nettoyage" loading="lazy">{% endif %}
  <figcaption class="photo__tag">{{ label }}</figcaption>
</figure>
