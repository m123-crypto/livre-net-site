---
layout: layouts/base.njk
---
<article>
  <section class="page-hero">
    <div class="wrap wrap--narrow">
      <p class="crumbs"><a href="/">Accueil</a> › <a href="/conseils/">Conseils</a></p>
      <h1>{{ titre }}</h1>
      <p class="muted">Publié le <time datetime="{{ page.date | isoDate }}">{{ page.date | dateFr }}</time></p>
    </div>
  </section>
  <section class="section">
    <div class="wrap wrap--narrow prose">
      {% if image %}<img class="prose__img" src="{{ image }}" alt="">{% endif %}
      {{ content | safe }}
    </div>
  </section>
</article>
{% include "partials/cta.njk" %}
