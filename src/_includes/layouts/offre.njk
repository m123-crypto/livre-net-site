    <p class="crumbs"><a href="/">Accueil</a> › <a href="/recrutement/">Recrutement</a></p>
    <h1>{{ titre }}</h1>
    <ul class="chips"><li>{{ contrat }}</li><li>{{ lieu }}</li><li>{{ horaires }}</li></ul>
